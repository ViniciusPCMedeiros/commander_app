# Supabase Local / Nuvem
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Provedor de IA (Google Gemini Gratuito - Google AI Studio)
# Com AI_API_KEY ausente ou "placeholder", o app usa o gerador local de fallback.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL: lista em ordem de preferência; em sobrecarga (503) ou cota esgotada (429)
# tenta o próximo. Use versões fixas (não "-latest") para o modelo não mudar sozinho.
# Projeto sem faturamento no AI Studio = plano gratuito: estourar a cota não gera cobrança.
AI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
AI_API_KEY=sua_gemini_api_key_aqui

# Conta root (conta de sistema, invisível para os demais). Usada só para criá-la
# na primeira subida; se omitir, o ./start.sh pergunta. A senha não é salva.
# ROOT_EMAIL=voce@exemplo.com
# ROOT_NAME=Root
# ROOT_PASSWORD=troque-esta-senha
